# Copy this file to /etc/bbb-agent.env on the server and fill in real values.
# Never commit the filled-in file.

# Bind Spring Boot to localhost; Nginx is the public entry point.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18080

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=bobo_db
MYSQL_USERNAME=bobo_user
MYSQL_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Alibaba Cloud OSS. The current code uses the Alibaba OSS SDK.
# OSS bucket details from the current Alibaba Cloud console.
# Fill the two credential values with a newly generated key pair.
OSS_ENABLED=true
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_BUCKET=bbb-image-prod
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=CHANGE_ME
ALIYUN_OSS_ACCESS_KEY_SECRET=CHANGE_ME

# Object prefixes
OSS_SOURCE_PREFIX=source
OSS_OUTPUT_PREFIX=output
OSS_THUMBNAIL_PREFIX=thumbnail
OSS_ARCHIVE_PREFIX=one and one
OSS_UPLOAD_POLICY_TTL=600s
OSS_SIGNED_URL_TTL=600s
OSS_MAX_OBJECT_BYTES=20971520

# Optional model/image settings. Defaults are defined in application.yml.
# QWEN_VISION_MODEL=qwen-vl-plus
# ZINE_IMAGE_MODEL=qwen-image-3.0-pro
# ZINE_IMAGE_TIMEOUT=180s
